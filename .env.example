# Copia este archivo como .env (local) o carga estas variables en Vercel > Settings > Environment Variables

# Cadena de conexión de MongoDB Atlas (en Atlas, Network Access debe permitir 0.0.0.0/0 para Vercel)
MONGODB_URL=mongodb+srv://usuario:password@cluster.mongodb.net/ventabot

# Secreto para firmar los JWT (obligatorio en producción). Genera uno largo y aleatorio.
TOKEN_SECRET=cambia-esto-por-un-secreto-largo

# Opcionales
# PORT=3030
# GRAPH_API_VERSION=v23.0
# Solo si el frontend está en otro dominio distinto al de la API:
# CORS_ORIGIN=https://mi-frontend.com
